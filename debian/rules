#!/usr/bin/make -f

export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/target/debian

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_install:
	install -D -m 0755 target/debian/release/pkremer-gnomehandy debian/tmp/usr/bin/pkremer-gnomehandy
	install -D -m 0644 debian/pkremer-gnomehandy.service debian/tmp/usr/lib/systemd/user/pkremer-gnomehandy.service
	install -D -m 0644 debian/gnomehandy-tel-handler.desktop debian/tmp/usr/share/applications/gnomehandy-tel-handler.desktop
	install -d debian/tmp/usr/share/gnome-shell/extensions/handy@pkremer.de/schemas
	install -m 0644 gnome-extension/*.js gnome-extension/*.css gnome-extension/metadata.json debian/tmp/usr/share/gnome-shell/extensions/handy@pkremer.de/
	install -m 0644 gnome-extension/schemas/*.xml debian/tmp/usr/share/gnome-shell/extensions/handy@pkremer.de/schemas/
	glib-compile-schemas --strict debian/tmp/usr/share/gnome-shell/extensions/handy@pkremer.de/schemas

override_dh_auto_test:
	cargo test --locked

override_dh_auto_clean:
	cargo clean || true
	rm -rf debian/tmp debian/cargo-home
